{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth" },
    { "source": "/api/products/:path*", "destination": "/api/products" },
    { "source": "/api/admin/:path*", "destination": "/api/admin" },
    { "source": "/api/orders/:path*", "destination": "/api/orders" },
    { "source": "/api/mongodb/:path*", "destination": "/api/mongodb" },
    { "source": "/api/analytics/:path*", "destination": "/api/analytics" },
    { "source": "/api/analytics", "destination": "/api/analytics" },
    { "source": "/api/cms/:path*", "destination": "/api/cms" },
    { "source": "/api/cms", "destination": "/api/cms" },
    { "source": "/api/app/:path*", "destination": "/api/app" },
    { "source": "/api/app", "destination": "/api/app" },
    { "source": "/api/messages/:path*", "destination": "/api/messages" },
    { "source": "/api/messages", "destination": "/api/messages" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/login", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/storefront", "destination": "/index.html" },
    { "source": "/storefront/:path*", "destination": "/index.html" },
    { "source": "/streaming", "destination": "/index.html" },
    { "source": "/subscriptions", "destination": "/index.html" },
    { "source": "/giftcards", "destination": "/index.html" },
    { "source": "/gaming", "destination": "/index.html" },
    { "source": "/software", "destination": "/index.html" },
    { "source": "/smart-projectors", "destination": "/index.html" },
    { "source": "/smart-4k-projectors", "destination": "/index.html" },
    { "source": "/ai-subscriptions", "destination": "/index.html" },
    { "source": "/steam-game-keys", "destination": "/index.html" },
    { "source": "/windows-office", "destination": "/index.html" },
    { "source": "/creative-software", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/refund-policy", "destination": "/index.html" },
    { "source": "/shipping-policy", "destination": "/index.html" },
    { "source": "/warranty", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/compare", "destination": "/index.html" },
    { "source": "/product/:path*", "destination": "/index.html" },
    { "source": "/category/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
