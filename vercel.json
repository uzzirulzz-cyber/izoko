{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/generate-legal-pages.mjs && vite build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/legal/privacy", "destination": "/privacy", "permanent": true },
    { "source": "/legal/terms", "destination": "/terms", "permanent": true },
    { "source": "/legal/terms-and-conditions", "destination": "/terms", "permanent": true },
    { "source": "/legal/refund", "destination": "/refund-policy", "permanent": true },
    { "source": "/legal/refund-policy", "destination": "/refund-policy", "permanent": true },
    { "source": "/legal/shipping", "destination": "/shipping-policy", "permanent": true },
    { "source": "/legal/shipping-policy", "destination": "/shipping-policy", "permanent": true },
    { "source": "/legal/delivery", "destination": "/shipping-policy", "permanent": true },
    { "source": "/legal/warranty", "destination": "/warranty", "permanent": true },
    { "source": "/legal/contact", "destination": "/contact", "permanent": true },
    { "source": "/legal", "destination": "/terms", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth" },
    { "source": "/api/products/:path*", "destination": "/api/products" },
    { "source": "/api/admin/:path*", "destination": "/api/admin" },
    { "source": "/api/orders/:path*", "destination": "/api/orders" },
    { "source": "/api/orders", "destination": "/api/orders" },
    { "source": "/api/payments/:path*", "destination": "/api/payments" },
    { "source": "/api/payments", "destination": "/api/payments" },
    { "source": "/api/mongodb/:path*", "destination": "/api/mongodb" },
    { "source": "/api/analytics/:path*", "destination": "/api/analytics" },
    { "source": "/api/analytics", "destination": "/api/analytics" },
    { "source": "/api/cms/:path*", "destination": "/api/cms" },
    { "source": "/api/cms", "destination": "/api/cms" },
    { "source": "/api/app/:path*", "destination": "/api/app" },
    { "source": "/api/app", "destination": "/api/app" },
    { "source": "/api/messages/:path*", "destination": "/api/messages" },
    { "source": "/api/messages", "destination": "/api/messages" },
    { "source": "/webhooks/rapid-gateway", "destination": "/api/payments?rapid=1" },
    { "source": "/order/:path*", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/account/:path*", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/login", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/storefront", "destination": "/index.html" },
    { "source": "/storefront/:path*", "destination": "/index.html" },
    { "source": "/streaming", "destination": "/index.html" },
    { "source": "/subscriptions", "destination": "/index.html" },
    { "source": "/giftcards", "destination": "/index.html" },
    { "source": "/gaming", "destination": "/index.html" },
    { "source": "/software", "destination": "/index.html" },
    { "source": "/smart-projectors", "destination": "/index.html" },
    { "source": "/smart-4k-projectors", "destination": "/index.html" },
    { "source": "/ai-subscriptions", "destination": "/index.html" },
    { "source": "/steam-game-keys", "destination": "/index.html" },
    { "source": "/windows-office", "destination": "/index.html" },
    { "source": "/creative-software", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/refund-policy", "destination": "/refund-policy.html" },
    { "source": "/shipping-policy", "destination": "/shipping-policy.html" },
    { "source": "/warranty", "destination": "/warranty.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/compare", "destination": "/index.html" },
    { "source": "/product/:path*", "destination": "/index.html" },
    { "source": "/category/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
