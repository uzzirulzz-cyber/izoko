# =============================================================================
# PlayBeat (izoko) — environment template
#
# Copy the real values into Vercel Project Settings → Environment Variables
# (or `vercel env add`). NEVER commit real secrets, keys or passwords to git —
# this repository is PUBLIC and git history is permanent. If a secret was ever
# committed, rotate it immediately (Atlas DB user password, admin password,
# SESSION_SECRET, gateway keys).
# =============================================================================

# ---- Database (MongoDB Atlas) -----------------------------------------------
#mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true
MONGODB_URI=""
MONGODB_DB_NAME="playbeat"

# ---- Sessions / JWT ----------------------------------------------------------
# Long random string (openssl rand -hex 48). Rotating it signs everyone out.
SESSION_SECRET=""

# ---- Super-admin bootstrap (admin console login) -----------------------------
ADMIN_EMAIL="admin@playbeat.digital"
ADMIN_PASSWORD=""

# ---- Public URL (webhook/return URL construction) ----------------------------
PUBLIC_SITE_URL="https://playbeat.digital"

# ---- Rapid Gateway (payments) -------------------------------------------------
# Secret key from the Rapid portal (Dashboard → Developers). Server-side ONLY.
RAPID_SECRET_KEY=""
# Optional overrides
RAPID_API_BASE="https://api.rapidgateway.pk"
# Comma-separated payment methods shown on hosted checkout
RAPID_METHODS="easypaisa,jazzcash,card"
# Webhook receiver: https://playbeat.digital/webhooks/rapid-gateway
# (salt configured in the portal must be mirrored in RAPID_WEBHOOK_SECRET)
RAPID_WEBHOOK_SECRET=""
# Optional previous salt during rotation
RAPID_WEBHOOK_SECRET_PREVIOUS=""

# ---- Social OAuth (optional — Google, Facebook & Instagram) -------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# Instagram API with Instagram Login (app id + secret from the Instagram product)
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""
# Meta webhooks subscribe verification token (any long random string — the same
# value is pasted into the Meta app's Webhooks "Verify token" field).
# Callback URLs (paste into the Meta app console):
#   Webhook:            https://playbeat.digital/api/auth/meta/webhook
#   Data deletion:      https://playbeat.digital/api/auth/meta/data-deletion
#   Deauthorize:        https://playbeat.digital/api/auth/meta/deauthorize
META_WEBHOOK_VERIFY_TOKEN=""

# ---- Google business tracking (PUBLIC IDs — safe for frontend) -----------------
# Preferred: leave empty and manage at runtime via Admin → Business Analytics
# (stored in MongoDB; overrides these env values without a redeploy).
GA4_MEASUREMENT_ID=""            # G-XXXXXXXXXX
GTM_CONTAINER_ID=""              # GTM-XXXXXXX
ADSENSE_CLIENT_ID=""             # ca-pub-XXXXXXXXXXXXXXXX (also feeds ads.txt at build)
GOOGLE_ADS_CONVERSION_ID=""      # AW-XXXXXXXXX
GOOGLE_ADS_PURCHASE_LABEL=""     # conversion label from your Google Ads purchase action
ADS_ENABLED=""                   # "true" (default) / "false" master switch for on-site ads

# ---- Customer mobile app (Android + iOS) ---------------------------------------
# Store listings / download URLs shown on the storefront (/download, footer,
# homepage section). DB config (Admin → Mobile Apps) always overrides these;
# empty URL = honest "Pending deployment" state (never a fake link).
ANDROID_APP_URL=""               # optional override — empty = signed APK from github.com/uzzirulzz-cyber/Playbeat-Digital-apk releases (or a Play listing / /downloads/app.apk)
ANDROID_APP_VERSION="1.0.0"
ANDROID_APP_BUILD="1"
ANDROID_MIN_OS="7.0 (API 24)"
ANDROID_APP_AVAILABLE=""         # empty/true = APK default live; "false" = hide
ANDROID_PACKAGE_NAME="digital.playbeat.app"
IOS_APP_URL=""                   # https://apps.apple.com/app/…
IOS_APP_VERSION="1.0.0"
IOS_APP_BUILD="1"
IOS_MIN_OS="16.0"
IOS_APP_AVAILABLE="false"        # "true" once the App Store listing is live
IOS_BUNDLE_ID="digital.playbeat.app"
APP_DOWNLOAD_PAGE_VISIBLE="true" # /download landing page
APP_FOOTER_VISIBLE="true"        # footer Download App column + CTA band
APP_HOME_SECTION_VISIBLE="true"  # homepage Get-the-App section
APP_QR_DESTINATION="download"    # download | android | ios
APP_PROMO_BANNER=""              # optional announcement on /download
# Frontend build-time fallbacks (used only if /api/app/storefront is unreachable)
VITE_ANDROID_APP_URL=""
VITE_IOS_APP_URL=""

# ---- Frontend build-time (optional API base override) --------------------------
# Leave empty to use same-origin /api/*
VITE_API_BASE=""

# ---- Transactional email (Section 4.4 digital delivery) ------------------------
# Provider: Resend (https://resend.com) — plain fetch, zero dependencies.
# When RESEND_API_KEY is empty, order confirmations fall back to in-app
# notifications ONLY (Account → Alerts) — the system never pretends an email
# was sent, and emailStatus is recorded on the order truthfully.
RESEND_API_KEY=""                 # empty = email disabled (honest in-app fallback)
EMAIL_FROM="PlayBeat Digital <onboarding@resend.dev>"  # set a verified domain sender in production
