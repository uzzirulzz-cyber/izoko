# =============================================================================
# PlayBeat (izoko) — environment template
#
# Copy the real values into Vercel Project Settings → Environment Variables
# (or `vercel env add`). NEVER commit real secrets, keys or passwords to git —
# this repository is PUBLIC and git history is permanent. If a secret was ever
# committed, rotate it immediately (Atlas DB user password, admin password,
# SESSION_SECRET, gateway keys).
# =============================================================================

# ---- Database (MongoDB Atlas) -----------------------------------------------
#mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true
MONGODB_URI=""
MONGODB_DB_NAME="playbeat"

# ---- Sessions / JWT ----------------------------------------------------------
# Long random string (openssl rand -hex 48). Rotating it signs everyone out.
SESSION_SECRET=""

# ---- Super-admin bootstrap (admin console login) -----------------------------
ADMIN_EMAIL="admin@playbeat.digital"
ADMIN_PASSWORD=""

# ---- Public URL (webhook/return URL construction) ----------------------------
PUBLIC_SITE_URL="https://playbeat.digital"

# ---- Rapid Gateway (payments) -------------------------------------------------
# Secret key from the Rapid portal (Dashboard → Developers). Server-side ONLY.
RAPID_SECRET_KEY=""
# Optional overrides
RAPID_API_BASE="https://api.rapidgateway.pk"
# Comma-separated payment methods shown on hosted checkout
RAPID_METHODS="easypaisa,jazzcash,card"
# Webhook receiver: https://playbeat.digital/webhooks/rapid-gateway
# (salt configured in the portal must be mirrored in RAPID_WEBHOOK_SECRET)
RAPID_WEBHOOK_SECRET=""
# Optional previous salt during rotation
RAPID_WEBHOOK_SECRET_PREVIOUS=""

# ---- Social OAuth (optional) ---------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

# ---- Frontend build-time (optional API base override) --------------------------
# Leave empty to use same-origin /api/*
VITE_API_BASE=""
